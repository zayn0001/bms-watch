# Email SMTP Settings (For sending ticket alerts)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_TO=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Supabase Auth & Storage (Shared with evenly & openGym)
SUPABASE_URL=https://ismyhkcsxrswqsfzfrxe.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
MIRROR_ENDPOINT=https://ismyhkcsxrswqsfzfrxe.storage.supabase.co/storage/v1/s3
MIRROR_BUCKET=default
MIRROR_PREFIX=bms_watch/
MIRROR_REGION=ap-southeast-1
MIRROR_KEY_ID=your_supabase_s3_key_id
MIRROR_SECRET=your_supabase_s3_secret_key

# Web & Worker Configuration
PORT=8000
POLL_INTERVAL=180

# Supabase database password (Project Settings > Database), used by scripts/db_push.py
POSTGRES_PASSWORD=

# Admin: sees and manages every watch (comma-separated Supabase user ids or emails)
ADMIN_UID=

# Secret for /api/cron, sent by the scheduled GitHub Action as X-Cron-Secret (same value as the repo secret)
CRON_SECRET=
